{
	"name": "ldp-api-docs",
	"private": true,
	"scripts": {
		"build": "node scripts/build.mjs",
		"clear": "docusaurus clear",
		"serve": "docusaurus serve --no-open --port 8765",
		"start": "docusaurus start --port 8765",
		"test": "node --test site.config.test.mjs scripts/*.test.mjs",
		"check:secrets": "node scripts/check-secrets.mjs specs docs",
		"gen": "node scripts/gen.mjs",
		"lint:specs": "node scripts/lint-specs.mjs",
		"check": "npm test && npm run lint:specs && npm run gen && npm run check:secrets && npm run build",
		"deploy": "npm run check && USE_SSH=true docusaurus deploy --skip-build",
		"prestart": "npm run gen",
		"introspect": "node scripts/introspect.mjs"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@docusaurus/core": "3.10.2",
		"@docusaurus/preset-classic": "3.10.2",
		"@graphql-markdown/docusaurus": "1.37.0",
		"@graphql-tools/graphql-file-loader": "8.1.20",
		"@mdx-js/react": "3.1.1",
		"clsx": "2.1.1",
		"docusaurus-plugin-openapi-docs": "5.2.0",
		"docusaurus-theme-openapi-docs": "5.2.0",
		"prism-react-renderer": "2.4.1",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@docusaurus/module-type-aliases": "3.10.2",
		"@docusaurus/tsconfig": "3.10.2",
		"@docusaurus/types": "3.10.2",
		"@redocly/cli": "2.54.2",
		"graphql": "16.14.2",
		"typescript": "5.9.3"
	},
	"browserslist": {
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	}
}
